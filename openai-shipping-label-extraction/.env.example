# OpenAI API key (https://platform.openai.com/api-keys) - gpt-4o-mini reads the label images
OPENAI_API_KEY=

# Opik: the defaults below target a local self-hosted Opik. For Opik Cloud, run `opik configure`
# or set OPIK_API_KEY and OPIK_URL_OVERRIDE=https://www.comet.com/opik/api and your OPIK_WORKSPACE.
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
