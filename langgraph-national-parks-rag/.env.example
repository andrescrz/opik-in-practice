# Copy to .env here or at any parent folder; main.py walks up to the first .env it finds.
OPENAI_API_KEY=sk-...

# Opik: local self-hosted by default (no key needed). For Opik Cloud, set
# OPIK_API_KEY and OPIK_WORKSPACE instead and drop OPIK_URL_OVERRIDE.
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
