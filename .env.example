# Copy to .env at the repo root and fill in. Every example walks up from its own
# folder to find this file. Each example also has its own .env.example listing
# only the variables it reads.

# --- Opik ---------------------------------------------------------------------
# Local self-hosted Opik (https://github.com/comet-ml/opik): no API key needed.
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# Opik Cloud instead: OPIK_URL_OVERRIDE=https://www.comet.com/opik/api/ plus a key
# from https://www.comet.com/opik (profile -> API keys).
# OPIK_API_KEY=
# Examples set their own project name; override only if you want to.
# OPIK_PROJECT_NAME=

# --- Model providers ----------------------------------------------------------
OPENAI_API_KEY=             # most examples: https://platform.openai.com/api-keys
ANTHROPIC_API_KEY=          # litellm-code-review-router only: https://console.anthropic.com/

# --- Example-specific (optional, defaults shown) -------------------------------
# OLLAMA_BASE_URL=http://localhost:11434   # ollama-langchainjs-homebrew-rag
# IMAGE_MODEL=gpt-image-1-mini             # openai-py-storybook-illustrations
# OPIK_GENAI_MAPPING=on                    # voltagent-restaurant-reservations (off = raw spans)
# N8N_PORT=5678                            # n8n-food-bank-volunteer-screening
# DIFY_PORT=8090                           # dify-gym-assistant
