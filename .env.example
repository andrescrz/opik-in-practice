# Copy to .env at the repo root and fill in. Every example walks up to the repo root to find it.

# --- Opik (local self-hosted; no API key needed) ---
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# OPIK_API_KEY=             # only for Opik Cloud: https://www.comet.com/opik
# OTLP endpoint for OpenTelemetry-based examples: ${OPIK_URL_OVERRIDE}v1/private/otel (header Comet-Workspace=default)

# --- LLM providers ---
OPENAI_API_KEY=             # required by most examples: https://platform.openai.com/api-keys
ANTHROPIC_API_KEY=          # used by the multi-provider examples: https://console.anthropic.com/
