# OpenAI API key for gpt-4o-mini (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Opik: local self-hosted default shown. For Opik Cloud use https://www.comet.com/opik/api
# and also set OPIK_API_KEY (comet.com -> avatar -> API Keys) and OPIK_WORKSPACE.
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
OPIK_API_KEY=

# Online evaluation runs server-side, so the judge's provider key must ALSO be stored in Opik:
# Configuration -> AI Providers -> add OpenAI. This .env value is not enough for the judge.
