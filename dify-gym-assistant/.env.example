# OpenAI key: Dify stores it as its model-provider credential (gpt-4o-mini).
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional (defaults shown)
# DIFY_PORT=8090
# DIFY_ADMIN_EMAIL=desk@ironbark.example
# DIFY_ADMIN_PASSWORD=IronbarkDesk2026

# Opik: a local self-hosted Opik needs only the URL and workspace. For Opik Cloud
# use https://www.comet.com/opik/api/ plus an API key
# (https://www.comet.com/opik -> profile -> API keys).
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# OPIK_API_KEY=
