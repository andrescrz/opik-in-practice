# Copy to .env (here or at any parent folder; the app walks up to find the first one).

# --- Opik (local self-hosted needs no API key; Opik Cloud needs one) ---
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# OPIK_API_KEY=   # only for Opik Cloud: https://www.comet.com/opik

# --- LLM provider ---
# Required: https://platform.openai.com/api-keys
OPENAI_API_KEY=
