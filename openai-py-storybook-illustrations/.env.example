# Get a key at https://platform.openai.com/api-keys (gpt-image-1 may need organization verification).
OPENAI_API_KEY=

# Local self-hosted Opik (default port). For Opik Cloud, set OPIK_API_KEY and
# OPIK_WORKSPACE instead and remove OPIK_URL_OVERRIDE.
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
