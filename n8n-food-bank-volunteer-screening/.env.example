# OpenAI key: setup.sh turns it into an n8n credential at runtime; it is never
# written into the workflow file. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Port for the local n8n UI and webhook (default 5678)
# N8N_PORT=5678

# Opik: a local self-hosted Opik needs only the URL and workspace.
# For Opik Cloud use https://www.comet.com/opik/api/ plus your API key
# (https://www.comet.com/opik -> profile -> API keys).
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# OPIK_API_KEY=
