# OpenAI key for gpt-4o-mini (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Opik: local self-hosted by default (no key needed).
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# Opik Cloud instead: OPIK_URL_OVERRIDE=https://www.comet.com/opik/api/ and set the key
# from https://www.comet.com/opik
OPIK_API_KEY=
