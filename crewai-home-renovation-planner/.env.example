# OpenAI key used by all three agents (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Local self-hosted Opik (default install). For Opik Cloud, use
# https://www.comet.com/opik/api and also set OPIK_API_KEY.
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
