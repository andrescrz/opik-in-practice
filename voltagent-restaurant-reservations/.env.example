# OpenAI key for gpt-4o-mini: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Opik: local self-hosted by default (https://www.comet.com/docs/opik/self-host/overview).
# For Opik Cloud use https://www.comet.com/opik/api and set OPIK_API_KEY and OPIK_WORKSPACE.
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
OPIK_API_KEY=
OPIK_PROJECT_NAME=voltagent-restaurant-reservations

# Set to "off" to send VoltAgent's raw attributes and see what Opik shows without the mapping.
# OPIK_GENAI_MAPPING=off
