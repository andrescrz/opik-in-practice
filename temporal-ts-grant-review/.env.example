# Opik: local self-hosted by default (no key needed). Opik Cloud: set OPIK_API_KEY and
# OPIK_URL_OVERRIDE=https://www.comet.com/opik/api  (key from https://www.comet.com/opik)
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
OPIK_API_KEY=

# OpenAI key for the reviewer-summary activity: https://platform.openai.com/api-keys
OPENAI_API_KEY=
