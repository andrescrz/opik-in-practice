{
  "name": "temporal-ts-grant-review",
  "version": "1.0.0",
  "private": true,
  "description": "Durable grant-application review on Temporal + OpenAI, traced across client and worker with Opik",
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "demo": "tsx scripts/demo.ts",
    "worker": "tsx src/worker.ts",
