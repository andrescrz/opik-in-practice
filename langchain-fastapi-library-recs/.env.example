# Copy to .env here or in any parent folder; main.py walks up to the first .env it finds.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Opik: local self-hosted by default (no key needed). For Opik Cloud
# (https://www.comet.com/opik) set OPIK_API_KEY and OPIK_WORKSPACE and drop OPIK_URL_OVERRIDE.
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
